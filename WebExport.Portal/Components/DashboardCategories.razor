@using System.Globalization

<DataPanel Title="Artikelstärkste Kategorien" Icon="folder-tree" Class="h-full">
    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <div class="alert alert-error alert-soft" role="alert">
            <LucideIcon Name="circle-alert" Size="18" aria-hidden="true" /> @Error
        </div>
    }
    else if (Categories is null)
    {
        <div class="space-y-4" aria-busy="true" aria-label="Kategorien werden geladen">
            @for (var i = 0; i < 5; i++)
            {
                <div class="flex items-center gap-3" aria-hidden="true">
                    <div class="skeleton size-7 shrink-0 motion-reduce:animate-none"></div>
                    <div class="skeleton h-4 w-2/3 motion-reduce:animate-none"></div>
                </div>
            }
        </div>
    }
    else if (Categories.Length == 0)
    {
        <p class="text-sm text-base-content/70">Keiner aktiven Endkategorie sind Artikel zugeordnet.</p>
    }
    else
    {
        var maximum = Math.Max(1, Categories.Max(category => category.ArticleCount));
        <p class="text-sm text-base-content/70">Aktive Endkategorien nach Anzahl zugeordneter Artikel.</p>
        <ol class="space-y-1">
            @for (var i = 0; i < Categories.Length; i++)
            {
                var category = Categories[i];
                <li>
                    <a class="group grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-1 rounded-field px-1 py-2 hover:bg-base-200/70"
                       href="@($"/articles?category={category.CategoryNumber}")">
                        <span class="badge badge-ghost badge-sm row-span-2 tabular-nums" aria-hidden="true">@(i + 1)</span>
                        <span class="wrap-anywhere font-medium group-hover:underline">@category.CategoryName</span>
                        <span class="flex items-center gap-1 text-sm font-semibold tabular-nums">
                            @category.ArticleCount.ToString("N0", German)<span class="sr-only"> Artikel</span>
                            <LucideIcon Name="chevron-right" Size="14" Class="text-base-content/60" aria-hidden="true" />
                        </span>
                        <progress class="progress progress-accent col-span-2 h-1.5 w-full" value="@category.ArticleCount"
                                  max="@maximum" aria-hidden="true"></progress>
                    </a>
                </li>
            }
        </ol>
    }
</DataPanel>

@code {
    [Parameter] public DashboardTopCategoryDto[]? Categories { get; set; }
    [Parameter] public string? Error { get; set; }

    private static readonly CultureInfo German = CultureInfo.GetCultureInfo("de-DE");
}
