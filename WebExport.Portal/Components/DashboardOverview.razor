@using System.Globalization

@if (!string.IsNullOrWhiteSpace(Error))
{
    <div role="alert" class="alert alert-error alert-soft">
        <LucideIcon Name="circle-alert" Size="20" aria-hidden="true" />
        <div><strong>Sortimentskennzahlen</strong><p>@Error</p></div>
    </div>
}
else
{
    <section aria-label="Sortimentskennzahlen" aria-busy="@(Summary is null ? "true" : "false")" class="space-y-5">
        <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
            @foreach (var metric in Metrics)
            {
                <div class="stats min-w-0 border border-base-content/10 shadow backdrop-blur-md @metric.Surface">
                    <dl class="stat min-w-0 gap-3 p-3.5 sm:p-5">
                        <dt class="stat-title flex items-center justify-between gap-2 whitespace-normal text-sm font-medium text-inherit">
                            @metric.Title
                            <LucideIcon Name="@metric.Icon" Size="19" Class="shrink-0 opacity-75" aria-hidden="true" />
                        </dt>
                        <dd class="stat-value min-w-0 whitespace-normal wrap-anywhere text-2xl font-semibold tracking-tight tabular-nums sm:text-3xl lg:text-4xl">
                            @if (Summary is null)
                            {
                                <span class="skeleton block h-8 w-28 max-w-full motion-reduce:animate-none" aria-hidden="true"></span>
                            }
                            else
                            {
                                @metric.Value
                            }
                        </dd>
                        <dd class="stat-desc whitespace-normal text-xs text-inherit opacity-80">
                            @if (Summary is null)
                            {
                                <span class="skeleton block h-4 w-3/4 motion-reduce:animate-none" aria-hidden="true"></span>
                            }
                            else
                            {
                                @metric.Detail
                                @if (metric.Share is decimal share)
                                {
                                    <progress class="progress progress-accent mt-2 block h-1.5" max="100"
                                              value="@share.ToString(CultureInfo.InvariantCulture)" aria-hidden="true"></progress>
                                }
                            }
                        </dd>
                    </dl>
                </div>
            }
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
            <DataPanel Title="SKU-Verfügbarkeit" Icon="boxes">
                @if (Summary is null)
                {
                    <div class="flex flex-wrap items-center gap-6 py-2" aria-hidden="true">
                        <span class="skeleton size-32 rounded-full motion-reduce:animate-none"></span>
                        <div class="min-w-28 flex-1 space-y-3">
                            <span class="skeleton block h-5 w-3/4 motion-reduce:animate-none"></span>
                            <span class="skeleton block h-5 w-1/2 motion-reduce:animate-none"></span>
                        </div>
                    </div>
                }
                else
                {
                    var share = Percent(Summary.InStockSkuCount, Summary.SkuCount);
                    <div class="flex flex-wrap items-center gap-6 py-2">
                        @if (share is decimal percentage)
                        {
                            <div class="radial-progress text-accent @(percentage == 0 ? "before:invisible after:invisible" : "")"
                                 style="@GaugeStyle(percentage)" role="meter" aria-label="SKU-Anteil mit positivem Bestand"
                                 aria-valuenow="@percentage.ToString(CultureInfo.InvariantCulture)" aria-valuemin="0" aria-valuemax="100">
                                <span class="text-center text-base-content">
                                    <strong class="block text-xl tabular-nums">@FormatPercent(percentage)</strong>
                                    <span class="text-xs">mit Bestand</span>
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="grid size-32 place-items-center rounded-full border-8 border-base-300 text-xl" aria-hidden="true">—</div>
                        }
                        <dl class="min-w-32 flex-1 space-y-3">
                            <div class="flex flex-wrap items-center justify-between gap-2">
                                <dt class="flex items-center gap-2"><span class="status bg-accent" aria-hidden="true"></span>Mit Bestand</dt>
                                <dd class="font-semibold tabular-nums">@Number(Summary.InStockSkuCount)</dd>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2 border-t border-base-content/10 pt-3">
                                <dt class="flex items-center gap-2"><span class="status bg-base-300 ring-1 ring-base-content/25" aria-hidden="true"></span>Bestand ≤ 0</dt>
                                <dd class="font-semibold tabular-nums">@Number(Summary.OutOfStockSkuCount)</dd>
                            </div>
                        </dl>
                    </div>
                    <p class="mt-auto text-xs text-base-content/70">
                        @(Summary.SkuCount == 0 ? "Noch keine SKUs vorhanden." : $"Ausgewertete SKUs · {Number(Summary.SkuCount)}")
                    </p>
                }
            </DataPanel>

            <DataPanel Title="Lieferstatus bei Bestand ≤ 0" Icon="truck">
                @if (Summary is null)
                {
                    <div class="grid grid-cols-3 items-end gap-4 ps-8" aria-hidden="true">
                        @for (var row = 0; row < 3; row++)
                        {
                            <div class="grid justify-items-center gap-2">
                                <span class="skeleton h-28 w-1/2 motion-reduce:animate-none"></span>
                                <span class="skeleton h-4 w-3/4 motion-reduce:animate-none"></span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    var statuses = new[]
                    {
                        (Label: "Sofort lieferbar", Count: Summary.OutOfStockAvailableNow, Color: "bg-accent"),
                        (Label: "Bald lieferbar", Count: Summary.OutOfStockAvailableSoonSkuCount, Color: "bg-warning"),
                        (Label: "Nicht lieferbar", Count: Summary.OutOfStockNotAvailable, Color: "bg-base-content/50")
                    };
                    <div role="group" aria-label="Lieferanteile und SKU-Anzahl" class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-2 gap-y-2 text-xs sm:gap-x-3">
                        <div class="flex h-28 flex-col justify-between text-end tabular-nums text-base-content/65" aria-hidden="true">
                            <span>@(Summary.OutOfStockSkuCount > 0 ? "100 %" : "")</span>
                            <span>@(Summary.OutOfStockSkuCount > 0 ? "50 %" : "")</span>
                            <span>0</span>
                        </div>
                        <div class="relative h-28" aria-hidden="true">
                            <div class="absolute inset-0 flex flex-col justify-between">
                                <div class="border-t border-dashed border-base-content/15"></div>
                                <div class="border-t border-dashed border-base-content/15"></div>
                                <div class="border-t border-base-content/30"></div>
                            </div>
                            <div class="relative grid h-full grid-cols-3 gap-2">
                                @foreach (var status in statuses)
                                {
                                    var height = Percent(status.Count, Summary.OutOfStockSkuCount) ?? 0m;
                                    <div class="flex h-full items-end justify-center">
                                        <span class="w-1/2 max-w-14 rounded-t-md @status.Color"
                                              style="@FormattableString.Invariant($"height:{Math.Clamp(height, 0m, 100m):0.####}%")"></span>
                                    </div>
                                }
                            </div>
                        </div>
                        <dl class="col-start-2 grid grid-cols-3 gap-2 text-center">
                            @foreach (var status in statuses)
                            {
                                <div class="min-w-0 space-y-1">
                                    <dt class="text-base-content/75">@status.Label</dt>
                                    <dd class="font-semibold tabular-nums">@Number(status.Count) SKUs</dd>
                                </div>
                            }
                        </dl>
                    </div>
                    <p class="mt-auto text-xs text-base-content/70">
                        @(Summary.OutOfStockSkuCount == 0 ? "Keine SKUs mit Bestand ≤ 0." : $"Anteil an {Number(Summary.OutOfStockSkuCount)} SKUs ohne positiven Bestand. Mehrfachzuordnungen sind möglich.")
                    </p>
                }
            </DataPanel>
        </div>
    </section>
}

@code {
    [Parameter] public DashboardSummaryDto? Summary { get; set; }
    [Parameter] public string? Error { get; set; }

    private static readonly CultureInfo German = CultureInfo.GetCultureInfo("de-DE");

    private (string Title, string Icon, string Surface, string? Value, string? Detail, decimal? Share)[] Metrics =>
    [
        ("Artikel im Sortiment", "package", "bg-accent text-accent-content", Number(Summary?.ArticleCount),
            Summary is { } a ? $"{Number(a.ArticleCountIncDeleted)} insgesamt · {Number(a.ArticleCountIncDeleted - a.ArticleCount)} gelöscht" : null, null),
        ("SKUs im Sortiment", "barcode", "bg-base-100/80", Number(Summary?.SkuCount),
            Summary is { ArticleCount: > 0 } s ? $"Ø {Number(decimal.Round((decimal)s.SkuCount / s.ArticleCount, 1))} SKUs je Artikel" : "Varianten im Sortiment", null),
        ("Gesamtbestand", "warehouse", "bg-base-100/80", Number(Summary?.TotalStock),
            "Einheiten über alle SKUs", null),
        ("Reduzierte SKUs", "tags", "bg-base-100/80", Number(Summary?.DiscountedSkuCount),
            Summary is { } p && Percent(p.DiscountedSkuCount, p.SkuCount) is { } share
                ? $"{FormatPercent(share)} reduziert · {Number(p.NonDiscountedSkuCount)} regulär"
                : "Keine SKUs zur Preisaufteilung", Percent(Summary?.DiscountedSkuCount ?? 0, Summary?.SkuCount ?? 0))
    ];

    private static string? Number(decimal? value) => value?.ToString("#,0.############################", German);

    private static decimal? Percent(int count, int total) => total > 0 ? 100m * count / total : null;

    private static string FormatPercent(decimal percentage) => $"{percentage.ToString("0.#", German)} %";

    private static string GaugeStyle(decimal percentage) =>
        FormattableString.Invariant($"--value:{Math.Clamp(percentage, 0m, 100m):0.####};--size:8rem;--thickness:.65rem;box-shadow:inset 0 0 0 var(--thickness) var(--color-base-300)");
}
