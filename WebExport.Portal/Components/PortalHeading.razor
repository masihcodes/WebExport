@code {
    [Parameter, EditorRequired] public string Section { get; set; } = "";
    [Parameter, EditorRequired] public string Icon { get; set; } = "";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Tenant { get; set; }
    [Parameter] public bool LoadingTitle { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}


<header class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0 space-y-3">
        <span class="badge badge-outline gap-2 border-primary/25 bg-base-100/40 text-primary">
            <LucideIcon Name="@Icon" Size="14" /> Datenportal · @Section
        </span>
        <h1 class="text-3xl font-semibold leading-tight tracking-tight wrap-anywhere focus:outline-none sm:text-4xl">
            @if (LoadingTitle)
            {
                <span class="sr-only">@Section</span>
                <span class="skeleton block h-9 w-56 max-w-full motion-reduce:animate-none"></span>
            }
            else
            {
                @(string.IsNullOrWhiteSpace(Title) ? Section : Title)
            }
        </h1>
        @if (!string.IsNullOrWhiteSpace(Tenant))
        {
            <p class="flex items-center gap-2 text-sm text-base-content/70">
                <LucideIcon Name="building-2" Size="16" /> @Tenant
            </p>
        }
    </div>
    @ChildContent
</header>