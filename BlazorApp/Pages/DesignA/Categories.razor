@page "/design-a/categories"
@layout DesignALayout

<main class="mx-auto p-5 sm:p-8 min-w-0 lg:ml-60">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0f766e]">Datenportal · Kategorien</p>
            <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight">Struktur für Ihr Sortiment</h1>
            <p class="mt-3 text-sm text-slate-500">Modehaus Muster GmbH</p>
        </div>
    </div>

    <div class="grid gap-6 xl:grid-cols-[1.4fr_1fr]">
        <section class="min-w-0 rounded-2xl border border-[#e2e8ed] bg-white p-5 shadow-xs sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-semibold tracking-tight">Kategoriebaum</h2>
            </div>
            <label class="mb-6 flex items-center gap-2 text-sm">
                <input class="size-4 accent-[#0f766e]" type="checkbox" @bind="_activeOnly" />
                Nur aktive Kategorien
            </label>
            <details open="" class="group">
                <summary class="mb-4 cursor-pointer rounded-xl bg-[#f2f6f7] p-4 text-sm font-semibold">
                    Herren
                    <span class="ml-2 font-normal text-slate-500">#1 · Rang 1 · Aktiv</span>
                </summary>
                <button type="button" class="mb-3 text-xs font-semibold text-[#0f766e] underline underline-offset-4" @onclick="() => SelectCategory(1)" aria-label="Details zu Herren">Details</button>
                <div class="ml-5 border-l border-slate-200 pl-4">
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#e2e8ed] bg-white p-4">
                        <div>
                            <a class="text-sm font-semibold text-[#0f766e] underline-offset-4 hover:underline" href="/design-a/articles?category=7">Anzüge</a>
                            <span class="ml-2 text-xs text-slate-400">#7</span>
                            <p class="mt-1 text-xs text-slate-500">Rang 1 · Aktiv</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <button type="button" class="text-xs font-semibold text-slate-500 underline" @onclick="() => SelectCategory(7)" aria-label="Details zu Anzüge">Details</button>
                            <Icon Name="LucideIcon.ArrowRight" Class="size-4" aria-hidden="true" />
                        </div>
                    </div>
                    <details open="">
                        <summary class="mb-2 cursor-pointer rounded-xl bg-[#f2f6f7] p-4 text-sm font-semibold">
                            Hemden · #8
                            <a class="ml-3 text-xs text-[#0f766e] underline" href="/design-a/articles?category=8">Artikel ansehen</a>
                        </summary>
                        <button type="button" class="mb-3 text-xs font-semibold text-[#0f766e] underline underline-offset-4" @onclick="() => SelectCategory(8)" aria-label="Details zu Hemden">Details</button>
                        <div class="ml-4 border-l border-slate-200 pl-4">
                            <div class="mb-2 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#e2e8ed] bg-white p-4">
                                <div>
                                    <a class="text-sm font-semibold text-[#0f766e] underline-offset-4 hover:underline" href="/design-a/articles?category=112">Business</a>
                                    <span class="ml-2 text-xs text-slate-400">#112</span>
                                    <p class="mt-1 text-xs text-slate-500">Rang 1 · Aktiv</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <button type="button" class="text-xs font-semibold text-slate-500 underline" @onclick="() => SelectCategory(112)" aria-label="Details zu Business">Details</button>
                                    <Icon Name="LucideIcon.ArrowRight" Class="size-4" aria-hidden="true" />
                                </div>
                            </div>
                            <div class="mb-2 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#e2e8ed] bg-white p-4">
                                <div>
                                    <a class="text-sm font-semibold text-[#0f766e] underline-offset-4 hover:underline" href="/design-a/articles?category=113">Freizeit</a>
                                    <span class="ml-2 text-xs text-slate-400">#113</span>
                                    <p class="mt-1 text-xs text-slate-500">Rang 2 · Aktiv</p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <button type="button" class="text-xs font-semibold text-slate-500 underline" @onclick="() => SelectCategory(113)" aria-label="Details zu Freizeit">Details</button>
                                    <Icon Name="LucideIcon.ArrowRight" Class="size-4" aria-hidden="true" />
                                </div>
                            </div>
                        </div>
                    </details>
                    <div class="mb-2 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#e2e8ed] bg-white p-4">
                        <div>
                            <a class="text-sm font-semibold text-[#0f766e] underline-offset-4 hover:underline" href="/design-a/articles?category=12">Accessoires</a>
                            <span class="ml-2 text-xs text-slate-400">#12</span>
                            <p class="mt-1 text-xs text-slate-500">Rang 3 · Aktiv</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <button type="button" class="text-xs font-semibold text-slate-500 underline" @onclick="() => SelectCategory(12)" aria-label="Details zu Accessoires">Details</button>
                            <Icon Name="LucideIcon.ArrowRight" Class="size-4" aria-hidden="true" />
                        </div>
                    </div>
                    @if (!_activeOnly)
                    {
                        <div class="mb-2 flex flex-wrap items-center justify-between gap-3 rounded-xl border border-[#e2e8ed] bg-white p-4">
                            <div>
                                <a class="text-sm font-semibold text-[#0f766e] underline-offset-4 hover:underline" href="/design-a/articles?category=19">Archiv</a>
                                <span class="ml-2 text-xs text-slate-400">#19</span>
                                <p class="mt-1 text-xs text-slate-500">Rang 4 · Inaktiv</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <button type="button" class="text-xs font-semibold text-slate-500 underline" @onclick="() => SelectCategory(19)" aria-label="Details zu Archiv">Details</button>
                                <Icon Name="LucideIcon.ArrowRight" Class="size-4" aria-hidden="true" />
                            </div>
                        </div>
                    }
                </div>
            </details>
        </section>
        <section class="min-w-0 rounded-2xl border border-[#e2e8ed] bg-white p-5 shadow-xs sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-semibold tracking-tight">Kategoriedetail</h2>
            </div>
            <div>
                <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Nummer</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">@_selectedCategory.Number</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Name</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">@_selectedCategory.Name</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Übergeordnete Kategorie</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">@(_selectedCategory.ParentNumber?.ToString() ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Rang</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">@_selectedCategory.Rank</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Suchbegriffe</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">@(_selectedCategory.SearchTerms ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Aktiv</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                            <span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset @(_selectedCategory.IsActive ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">@(_selectedCategory.IsActive ? "Ja" : "Nein")</span>
                        </dd>
                    </div>
                </dl>
            </div>
        </section>
    </div>
</main>

@code {
    private bool _activeOnly;

    private static readonly CategoryItem[] CategoryItems =
    [
        new(1, "Herren", null, 1, null, true),
        new(7, "Anzüge", 1, 1, "Anzug Sakko", true),
        new(8, "Hemden", 1, 2, "Hemd", true),
        new(112, "Business", 8, 1, "Businesshemd", true),
        new(113, "Freizeit", 8, 2, "Freizeithemd", true),
        new(12, "Accessoires", 1, 3, "Gürtel Tuch", true),
        new(19, "Archiv", 1, 4, "Archiv", false)
    ];

    private CategoryItem _selectedCategory = CategoryItems[2];

    private void SelectCategory(int number)
    {
        _selectedCategory = CategoryItems.Single(category => category.Number == number);
    }

    private sealed record CategoryItem(
        int Number,
        string Name,
        int? ParentNumber,
        short Rank,
        string? SearchTerms,
        bool IsActive);
}
