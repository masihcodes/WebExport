@page "/design-a/login"

@inject HttpClient Http
@inject NavigationManager Navi
@inject Services.Session Session
@inject ILogger<Login> Logger

@inject ToastService Toast


@code
{
    private LoginDto _login = new LoginDto
    {
        ClientId = "",
        ClientSecret = ""
    };

    private AuthResponseDto? _credentials;
    private string _apiKey = "";
    private bool _showSecret;
    private bool _isLoading;
    private string? _error;


    private async Task HandleLoginAsync()
    {
        if (_isLoading) return;

        if (string.IsNullOrWhiteSpace(_login.ClientId))
        {
            Toast.Show(title: "Bitte geben Sie Ihre Client-ID ein.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_login.ClientSecret))
        {
            Toast.Show(title: "Bitte geben Sie Ihr Client-Secret ein.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_apiKey))
        {
            _error = "Bitte geben Sie Ihren API-Schlüssel ein.";
            Toast.Error(_error);
            return;
        }

        _isLoading = true;
        _error = null;

        try
        {
            using HttpRequestMessage req = new HttpRequestMessage(HttpMethod.Post, requestUri: "api/v1/auth/token");

            req.Headers.Add(name: "X-API-KEY", _apiKey.Trim());
            req.Content = JsonContent.Create(_login);

            using HttpResponseMessage res = await Http.SendAsync(req);

            if (!res.IsSuccessStatusCode)
            {
                ErrorResponseDto? apiErr = await res.Content.ReadFromJsonAsync<ErrorResponseDto>();
                _error = apiErr?.Message ?? "Die Anmeldung ist fehlgeschlagen.";
                Toast.Error(_error);
                return;
            }

            _credentials = await res.Content.ReadFromJsonAsync<AuthResponseDto>();

            if (_credentials is null || string.IsNullOrWhiteSpace(_credentials.AccessToken))
            {
                Toast.Error(title: "Die API hat keine gültige Token-Antwort geliefert.");
                return;
            }

            Session.SetCredentials(_credentials, _apiKey.Trim(), _login.ClientId);
            Navi.NavigateTo(uri: "/design-a/status");
            Toast.Success(title: "Anmeldung erfolgreich.");

        }
        catch (Exception ex)
        {
            Logger.LogError(ex, message: "An error occurred during login. Masih");
            Toast.Error("Die Anmeldung ist derzeit nicht möglich. Bitte versuchen Sie es erneut.");
        }
        finally
        {
            _isLoading = false;
        }
    }
}

<PageTitle>Anmeldung</PageTitle>

<Toaster RichColors="true" CloseButton="true" />

<div class="min-h-screen bg-slate-50 text-slate-800 antialiased selection:bg-teal-700">
    <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl items-center gap-3 px-5 py-6">
            <Icon Name="LucideIcon.Package" Class="size-7 animate-pulse" />
            <span class="text-lg font-semibold tracking-tight">
                WebExport <span class="font-normal opacity-50">Api</span>
            </span>
        </div>
    </header>

    <main class="mx-auto mb-7 max-w-7xl p-5 sm:p-8">
        <header class="mb-6">
            <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">Datenportal · Anmeldung</p>
            <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight">Zugang zum Datenportal</h1>
            <p class="mt-3 text-sm text-slate-500">Zugang mit Client-ID und Client-Secret</p>
        </header>

        <div class="grid overflow-hidden rounded-3xl border border-slate-400 bg-white shadow-2xl lg:grid-cols-2">
            <section class="flex flex-col justify-between bg-cyan-950 p-8 text-white sm:p-12">
                <div class="flex flex-col gap-4">
                    <div>
                        <Icon Name="LucideIcon.Package" Class="size-9" />
                        <span class="text-lg font-semibold tracking-tight">
                            WebExport <span class="font-normal opacity-60">Api</span>
                        </span>
                    </div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-white/50">Das Datenportal für
                        IhrSortiment
                    </p>
                </div>


                <div>
                    <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
                        AlleArtikeldaten.<br />Ein Zugang.
                    </h2>
                    <p class="mt-6 text-sm leading-7 text-white/60">Artikel, Preise und Filialbestände Ihres
                        Mandanten–übersichtlich an einem Ort.
                    </p>
                </div>

                <ul class="mt-9 space-y-4">
                    <li class="flex items-center gap-3">
                        <Icon Name="LucideIcon.CheckCheck" class=" size-8y rounded-full bg-white/10 p-1" />
                        <TextShimmer TextSize="TextSize.Sm" Leading="Leading.Is6" TextColor="TextColor.MutedForeground"
                                     class="text-white/60">
                            Ein Zugang für Ihren Mandanten
                        </TextShimmer>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon Name="LucideIcon.CheckCheck" class=" size-8y rounded-full bg-white/10 p-1" />
                        <TextShimmer TextSize="TextSize.Sm" Leading="Leading.Is6" TextColor="TextColor.MutedForeground"
                                     class="text-white/60">
                            Artikel bis zur einzelnen Variante
                        </TextShimmer>
                    </li>
                    <li class="flex items-center gap-3">
                        <Icon Name="LucideIcon.CheckCheck" class=" size-8y rounded-full bg-white/10 p-1" />
                        <TextShimmer TextSize="TextSize.Sm" Leading="Leading.Is6" TextColor="TextColor.MutedForeground"
                                     class="text-white/60">
                            Bestände nach Filiale anzeigen
                        </TextShimmer>
                    </li>
                </ul>

            </section>

            <section class="flex items-center p-8 sm:p-12">
                <div class="mx-auto w-full max-w-sm">
                    <div class="mb-6 flex size-12 items-center justify-center rounded-xl bg-slate-100 text-teal-700">
                        <Icon Name="LucideIcon.UserLock" />
                    </div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-teal-700">Willkommen im Datenportal
                    </p>
                    <h2 class="mt-3 text-3xl font-semibold tracking-tight">Anmelden</h2>
                    <p class="mb-8 mt-3 text-sm leading-6 text-slate-500">Geben Sie die Zugangsdaten Ihres API-Clients
                        ein.
                    </p>

                    <EditForm Model="_login" OnValidSubmit="HandleLoginAsync">
                        <DataAnnotationsValidator />

                        <label class="block text-xs font-semibold text-slate-600">
                            Client-ID:
                            <InputText @bind-Value="_login.ClientId" autocomplete="on"
                                       class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20" />
                            <ValidationMessage For="@(() => _login.ClientId)"
                                               class="mt-1 animate-pulse text-xs text-red-500" />
                        </label>

                        <label class="mt-5 block text-xs font-semibold text-slate-600">
                            Client-Secret:
                            <InputText @bind-Value="_login.ClientSecret" autocomplete="on"
                                       type="@(_showSecret ? "text" : "password")"
                                       class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20" />
                            <ValidationMessage For="@(() => _login.ClientSecret)"
                                               class="mt-1 animate-pulse text-xs text-red-500" />
                        </label>

                        <label class="mt-5 block text-xs font-semibold text-slate-600">
                            API-Schlüssel:
                            <InputText @bind-Value="_apiKey" type="@(_showSecret ? "text" : "password")"
                                       autocomplete="off"
                                       class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-teal-700 focus:ring-2 focus:ring-teal-700/20" />
                        </label>

                        <label class="mt-3 flex items-center gap-2 text-xs text-slate-500 hover:cursor-pointer">
                            <InputCheckbox @bind-Value="_showSecret" class="size-4 accent-teal-700" />
                            Secret / API-Schlüssel anzeigen
                        </label>

                        <Button Type="@ButtonType.Submit" Loading="@_isLoading" Block="true"
                                Class="mt-7 min-h-12 bg-teal-700 text-white hover:bg-teal-800">
                            @(_isLoading ? "Anmeldung läuft …" : "Anmelden")
                            <Icon Name="LucideIcon.ArrowRight" />
                        </Button>

                    </EditForm>

                </div>
            </section>
        </div>

        <footer
            class="mt-12 flex flex-wrap justify-between gap-3 border-t border-slate-200 pt-5 text-xs font-semibold text-slate-500">
            <span>HILTES Software GmbH · WebExportApi</span>
            <span>Postgres · ASP.NET Core · Blazor · HTML · Tailwind CSS · 10.2026</span>
        </footer>
    </main>
</div>
