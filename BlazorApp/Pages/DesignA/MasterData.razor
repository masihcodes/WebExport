@page "/design-a/master-data"
@layout DesignALayout

<main class="mx-auto p-5 sm:p-8 min-w-0 lg:ml-60">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0f766e]">Datenportal · Stammdaten</p>
            <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight">Die Basis Ihrer Artikeldaten</h1>
            <p class="mt-3 text-sm text-slate-500">Modehaus Muster GmbH</p>
        </div>
    </div>

    <section class="min-w-0 rounded-2xl border border-[#e2e8ed] bg-white p-5 shadow-xs sm:p-6">
        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-base font-semibold tracking-tight">Stammdaten durchsuchen</h2>
        </div>
        <div role="group" aria-label="Stammdatenbereiche" class="mb-6 flex flex-wrap gap-2">
            <button type="button" id="tab-colors" aria-controls="panel-colors" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 aria-pressed:border-[#0f766e] aria-pressed:bg-[#0f766e] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e]" @onclick="() => _activeTab = MasterDataTab.Colors" aria-pressed="@(_activeTab == MasterDataTab.Colors ? "true" : "false")">Farben</button>
            <button type="button" id="tab-sizes" aria-controls="panel-sizes" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 aria-pressed:border-[#0f766e] aria-pressed:bg-[#0f766e] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e]" @onclick="() => _activeTab = MasterDataTab.Sizes" aria-pressed="@(_activeTab == MasterDataTab.Sizes ? "true" : "false")">Größen</button>
            <button type="button" id="tab-branches" aria-controls="panel-branches" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 aria-pressed:border-[#0f766e] aria-pressed:bg-[#0f766e] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e]" @onclick="() => _activeTab = MasterDataTab.Branches" aria-pressed="@(_activeTab == MasterDataTab.Branches ? "true" : "false")">Filialen</button>
            <button type="button" id="tab-attributes" aria-controls="panel-attributes" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 aria-pressed:border-[#0f766e] aria-pressed:bg-[#0f766e] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e]" @onclick="() => _activeTab = MasterDataTab.Attributes" aria-pressed="@(_activeTab == MasterDataTab.Attributes ? "true" : "false")">Merkmalsarten</button>
            <button type="button" id="tab-delivery" aria-controls="panel-delivery" class="rounded-lg border border-slate-200 px-4 py-2.5 text-sm font-semibold text-slate-600 aria-pressed:border-[#0f766e] aria-pressed:bg-[#0f766e] aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e]" @onclick="() => _activeTab = MasterDataTab.Delivery" aria-pressed="@(_activeTab == MasterDataTab.Delivery ? "true" : "false")">Lieferstatus</button>
        </div>
        <section tabindex="0" id="panel-colors" aria-labelledby="tab-colors" hidden="@(_activeTab != MasterDataTab.Colors)">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                <div class="rounded-xl border border-[#e2e8ed] p-4">
                    <div class="mb-4 h-24 rounded-lg border border-slate-200 bg-[#002060]"></div>
                    <h3 class="text-sm font-semibold">Dunkelblau</h3>
                    <p class="mt-2 text-xs text-slate-500">ID 12 · RGB 0 / 32 / 96</p>
                </div>
                <div class="rounded-xl border border-[#e2e8ed] p-4">
                    <div class="mb-4 h-24 rounded-lg border border-slate-200 bg-white"></div>
                    <h3 class="text-sm font-semibold">Weiß</h3>
                    <p class="mt-2 text-xs text-slate-500">ID 13 · RGB 255 / 255 / 255</p>
                </div>
                <div class="rounded-xl border border-[#e2e8ed] p-4">
                    <div class="mb-4 h-24 rounded-lg border border-slate-200 bg-[#681c33]"></div>
                    <h3 class="text-sm font-semibold">Bordeaux</h3>
                    <p class="mt-2 text-xs text-slate-500">ID 14 · RGB 104 / 28 / 51</p>
                </div>
                <div class="rounded-xl border border-[#e2e8ed] p-4">
                    <div class="mb-4 h-24 rounded-lg border border-slate-200 bg-[#d1c1a8]"></div>
                    <h3 class="text-sm font-semibold">Sand</h3>
                    <p class="mt-2 text-xs text-slate-500">ID 15 · RGB 209 / 193 / 168</p>
                </div>
            </div>
        </section>
        <section tabindex="0" id="panel-sizes" aria-labelledby="tab-sizes" hidden="@(_activeTab != MasterDataTab.Sizes)">
            <div class="max-w-full overflow-x-auto rounded-xl border border-[#e2e8ed]">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">Größenstammdaten</caption>
                    <thead class="bg-[#f2f6f7] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">ID</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Größe</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Größenlauf</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Sortierung</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">7</td>
                            <td class="px-4 py-4 align-top tabular-nums">42</td>
                            <td class="px-4 py-4 align-top tabular-nums">Hemden</td>
                            <td class="px-4 py-4 align-top tabular-nums">4</td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">8</td>
                            <td class="px-4 py-4 align-top tabular-nums">44</td>
                            <td class="px-4 py-4 align-top tabular-nums">Hemden</td>
                            <td class="px-4 py-4 align-top tabular-nums">5</td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">20</td>
                            <td class="px-4 py-4 align-top tabular-nums">M</td>
                            <td class="px-4 py-4 align-top tabular-nums">Buchstaben</td>
                            <td class="px-4 py-4 align-top tabular-nums">2</td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">21</td>
                            <td class="px-4 py-4 align-top tabular-nums">L</td>
                            <td class="px-4 py-4 align-top tabular-nums">Buchstaben</td>
                            <td class="px-4 py-4 align-top tabular-nums">3</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        <section tabindex="0" id="panel-branches" aria-labelledby="tab-branches" hidden="@(_activeTab != MasterDataTab.Branches)">
            <div class="max-w-full overflow-x-auto rounded-xl border border-[#e2e8ed]">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">Filialen des angemeldeten Mandanten</caption>
                    <thead class="bg-[#f2f6f7] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Nummer</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Name</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Ort</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Aktiv</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">1</td>
                            <td class="px-4 py-4 align-top tabular-nums">Leer Innenstadt</td>
                            <td class="px-4 py-4 align-top tabular-nums">Leer</td>
                            <td class="px-4 py-4 align-top tabular-nums">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-800 ring-emerald-200">Ja</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">3</td>
                            <td class="px-4 py-4 align-top tabular-nums">Oldenburg</td>
                            <td class="px-4 py-4 align-top tabular-nums">Oldenburg</td>
                            <td class="px-4 py-4 align-top tabular-nums">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-800 ring-emerald-200">Ja</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        <section tabindex="0" id="panel-attributes" aria-labelledby="tab-attributes" hidden="@(_activeTab != MasterDataTab.Attributes)">
            <div class="max-w-full overflow-x-auto rounded-xl border border-[#e2e8ed]">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">Webshoprelevante Merkmalsarten und Merkmale</caption>
                    <thead class="bg-[#f2f6f7] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Typ-Nr.</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Merkmalsart</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Merkmal-Nr.</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Merkmal</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">1</td>
                            <td class="px-4 py-4 align-top tabular-nums">Kragenform</td>
                            <td class="px-4 py-4 align-top tabular-nums">4</td>
                            <td class="px-4 py-4 align-top tabular-nums">Kentkragen</td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">1</td>
                            <td class="px-4 py-4 align-top tabular-nums">Kragenform</td>
                            <td class="px-4 py-4 align-top tabular-nums">5</td>
                            <td class="px-4 py-4 align-top tabular-nums">Button-down</td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">2</td>
                            <td class="px-4 py-4 align-top tabular-nums">Ärmelform</td>
                            <td class="px-4 py-4 align-top tabular-nums">1</td>
                            <td class="px-4 py-4 align-top tabular-nums">Langarm</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
        <section tabindex="0" id="panel-delivery" aria-labelledby="tab-delivery" hidden="@(_activeTab != MasterDataTab.Delivery)">
            <div class="max-w-full overflow-x-auto rounded-xl border border-[#e2e8ed]">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">Texte je Lieferstatus</caption>
                    <thead class="bg-[#f2f6f7] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Status</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Deutsche Bezeichnung</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">availableNow</td>
                            <td class="px-4 py-4 align-top tabular-nums">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-800 ring-emerald-200">Sofort lieferbar</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">availableSoon</td>
                            <td class="px-4 py-4 align-top tabular-nums">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-amber-50 text-amber-900 ring-amber-200">Lieferbar in 3–5 Tagen</span>
                            </td>
                        </tr>
                        <tr class="hover:bg-[#f2f6f7]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">notAvailable</td>
                            <td class="px-4 py-4 align-top tabular-nums">
                                <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-700 ring-slate-200">Zurzeit nicht lieferbar</span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    </section>
</main>

@code {
    private MasterDataTab _activeTab = MasterDataTab.Colors;

    private enum MasterDataTab
    {
        Colors,
        Sizes,
        Branches,
        Attributes,
        Delivery
    }
}
