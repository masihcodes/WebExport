@page "/design-a/status"
@layout DesignALayout

@inject HttpClient Http
@inject NavigationManager Navi
@inject Services.Session Session

@inject ToastService Toast



@code {
    private TenantResponseDto? _tenant;
    private StatusResponseDto? _statusResponse;
    private bool _isLoading;
    private string? _error;


    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.ApiKey))
        {
            Session.Clear();
            Navi.NavigateTo(uri: "/design-a/login");
            return;
        }

        _isLoading = true;
        _error = null;

        try
        {
            using HttpRequestMessage tenantReq = new HttpRequestMessage(HttpMethod.Get, requestUri: "api/v1/tenant");
            tenantReq.Headers.Add(name: "X-API-KEY", Session?.ApiKey);
            tenantReq.Headers.Authorization = new AuthenticationHeaderValue(scheme: "Bearer", Session?.Current?.AccessToken);

            using HttpRequestMessage statusReq = new HttpRequestMessage(HttpMethod.Get, requestUri: "api/v1/status");
            statusReq.Headers.Add(name: "X-API-KEY", Session?.ApiKey);


            using HttpResponseMessage tenantRes = await Http.SendAsync(tenantReq);
            using HttpResponseMessage statusRes = await Http.SendAsync(statusReq);


            if (tenantRes.StatusCode == HttpStatusCode.Unauthorized || statusRes.StatusCode == HttpStatusCode.Unauthorized)
            {
                Session?.Clear();
                Navi.NavigateTo("/design-a/login");
                return;
            }

            if (!tenantRes.IsSuccessStatusCode)
            {
                ErrorResponseDto? apiErr = await tenantRes.Content.ReadFromJsonAsync<ErrorResponseDto>();
                _error = apiErr?.Message ?? "Die Statusabfrage ist fehlgeschlagen.";
                Toast.Error(_error);
                return;
            }

            if (!statusRes.IsSuccessStatusCode)
            {
                ErrorResponseDto? apiErr = await statusRes.Content.ReadFromJsonAsync<ErrorResponseDto>();
                _error = apiErr?.Message ?? "Die Statusabfrage ist fehlgeschlagen.";
                Toast.Error(_error);
                _statusResponse = new StatusResponseDto
                {
                    Status = "Nicht erreichbar",
                    Version = "—",
                    DatabaseAvailable = false,
                    Timestamp = DateTime.UtcNow
                };
            }
            else
            {
                _statusResponse = await statusRes.Content.ReadFromJsonAsync<StatusResponseDto>();
            }

            _tenant = await tenantRes.Content.ReadFromJsonAsync<TenantResponseDto>();
            Session?.SetTenant(_tenant!);
            Toast.Success(title: "Status aktualisiert.");
        }
        catch (HttpRequestException)
        {
            _error = "Die API konnte nicht erreicht werden.";
            Toast.Error(_error);
        }
        catch (OperationCanceledException)
        {
            _error = "Die Anfrage wurde abgebrochen oder hat zu lange gedauert.";
            Toast.Error(_error);
        }
        catch (Exception)
        {
            _error = "Bei der Verarbeitung der Anfrage ist ein unerwarteter Fehler aufgetreten.";
            Toast.Error(_error);
        }
        finally
        {
            _isLoading = false;
        }
    }

}

<PageTitle>Status</PageTitle>

<Toaster RichColors="@true" CloseButton="@true" />

<div class="min-w-0 lg:ml-60">

    @if (_isLoading)
    {
        <p role="status">Status wird aktualisiert…</p>
    }
    else
    {
        <main id="main" class="mx-auto max-w-[1600px] p-5 sm:p-8">
            <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0f766e]">Datenportal · Status</p>
                    <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight">Ihre Daten. Auf einen Blick.</h1>
                    <p class="mt-3 text-sm text-slate-500">@(_tenant?.Name ?? "—")</p>
                </div>
            </div>

            <div>
                <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
                    <div class="rounded-2xl border border-[#e2e8ed] bg-white p-6">
                        <div class="flex items-center justify-between">
                            <p class="text-xs font-semibold text-slate-500">API-Status</p>
                            <span
                            class="size-2 rounded-full @(_statusResponse?.Status == "OK" ? "bg-emerald-500" : "bg-red-500") animate-ping"></span>
                        </div>
                        <p class="mt-5 text-2xl font-semibold tracking-tight">
                            @(_statusResponse?.Status == "OK" ? "Erreichbar" : "Nicht erreichbar")
                        </p>
                        <p class="mt-2 text-xs text-slate-500">@(_statusResponse?.Version ?? "_")</p>
                    </div>
                    <div class="rounded-2xl border border-[#e2e8ed] bg-white p-6">
                        <div class="flex items-center justify-between">
                            <p class="text-xs font-semibold text-slate-500">Datenbank</p>
                            <span
                            class="size-2 rounded-full @(_statusResponse?.Status == "OK" ? "bg-emerald-500" : "bg-red-500") animate-ping"></span>
                        </div>
                        <p class="mt-5 text-2xl font-semibold tracking-tight">
                            @(_statusResponse is null ? "—" : _statusResponse.DatabaseAvailable ? "Verbunden" : "Nicht erreichbar")
                        </p>
                        <p class="mt-2 text-xs text-slate-500">
                            PostgreSQL · @(_statusResponse is null ? "—" : _statusResponse.DatabaseAvailable ? "Verbunden" :
                                                                                                                            "Nicht erreichbar")
                        </p>
                    </div>
                    <div class="rounded-2xl border border-[#e2e8ed] bg-white p-6">
                        <div class="flex items-center justify-between">
                            <p class="text-xs font-semibold text-slate-500">Mandant</p>
                            <span
                            class="size-2 rounded-full @(_statusResponse?.Status == "OK" ? "bg-emerald-500" : "bg-red-500") animate-ping"></span>
                        </div>
                        <p class="mt-5 text-2xl font-semibold tracking-tight">Nr. @Session?.Tenant?.Number</p>
                        <p class="mt-2 text-xs text-slate-500">@(_tenant?.Name ?? "—")</p>
                    </div>
                    <div class="rounded-2xl border border-[#e2e8ed] bg-white p-6">
                        <div class="flex items-center justify-between">
                            <p class="text-xs font-semibold text-slate-500">Filialen</p>
                            <span
                            class="size-2 rounded-full @(_statusResponse?.Status == "OK" ? "bg-emerald-500" : "bg-red-500") animate-ping"></span>
                        </div>
                        <p class="mt-5 text-2xl font-semibold tracking-tight">@(_tenant?.BranchCount.ToString() ?? "—")</p>
                        <p class="mt-2 text-xs text-slate-500">Filialen des Mandanten</p>
                    </div>
                </div>
                <div class="grid gap-6 xl:grid-cols-[1.3fr_1fr]">
                    <section class="min-w-0 rounded-2xl border border-[#e2e8ed] bg-white p-5 shadow-xs sm:p-6">
                        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                            <h2 class="text-base font-semibold tracking-tight">Ihr Datenzugang</h2>
                        </div>
                        <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                            <div>
                                <dt class="text-xs font-medium text-slate-500">Angemeldeter Mandant</dt>
                                <dd class="mt-1.5 wrap-break-word text-sm font-medium">@(_tenant?.Name ?? "—")</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500">Mandantennummer</dt>
                                <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                                    @(_tenant?.Number.ToString() ?? "—")
                                </dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500">Client-ID</dt>
                                <dd class="mt-1.5 wrap-break-word text-sm font-medium">@(Session?.ClientId)</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500">Sitzung</dt>
                                <dd class="mt-1.5 wrap-break-word text-sm font-medium">60 Minuten</dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500">Status geprüft am</dt>
                                <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                                    @(_statusResponse?.Timestamp.ToUniversalTime().ToString(format: "dd.MM.yyyy, HH:mm:ss 'UTC'") ?? "—")
                                </dd>
                            </div>
                            <div>
                                <dt class="text-xs font-medium text-slate-500">Umgebung</dt>
                                <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                                    <span
                                        class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-700 ring-slate-200">
                                        Lokale Testumgebung
                                    </span>
                                </dd>
                            </div>
                        </dl>
                        <p class="mt-6 rounded-xl bg-[#f2f6f7] p-4 text-sm leading-relaxed text-slate-600">
                            Der Mandant wird durch
                            den angemeldeten Client bestimmt. Die Filialauswahl schränkt die Bestandsanzeige ein.
                        </p>
                    </section>
                    <section class="min-w-0 rounded-2xl border border-[#e2e8ed] bg-white p-5 shadow-xs sm:p-6">
                        <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                            <h2 class="text-base font-semibold tracking-tight">Direkt zu Ihren Daten</h2>
                        </div>
                        <div class="space-y-3">
                            <a class="flex items-center justify-between rounded-xl border border-[#e2e8ed] p-4 transition hover:bg-[#f2f6f7]"
                               href="/design-a/articles">
                                <span>
                                    <span class="block font-semibold">Artikel ansehen</span>
                                    <span class="mt-1 block text-xs text-slate-500">Sortiment, Varianten und Details</span>
                                </span>
                                <Icon Name="LucideIcon.ArrowRight"></Icon>
                            </a>
                            <a class="flex items-center justify-between rounded-xl border border-[#e2e8ed] p-4 transition hover:bg-[#f2f6f7]"
                               href="/design-a/prices-stock">
                                <span>
                                    <span class="block font-semibold">Preise &amp; Bestände</span>
                                    <span class="mt-1 block text-xs text-slate-500">Kompakte Übersicht je SKU</span>
                                </span>
                                <Icon Name="LucideIcon.ArrowRight"></Icon>
                            </a>
                            <a class="flex items-center justify-between rounded-xl border border-[#e2e8ed] p-4 transition hover:bg-[#f2f6f7]"
                               href="/design-a/categories">
                                <span>
                                    <span class="block font-semibold">Kategorien erkunden</span>
                                    <span class="mt-1 block text-xs text-slate-500">Von der Struktur zum Artikel</span>
                                </span>
                                <Icon Name="LucideIcon.ArrowRight"></Icon>
                            </a>
                        </div>
                    </section>
                </div>
            </div>

        </main>
    }
</div>