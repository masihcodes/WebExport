@page "/design-a/articles"
@layout DesignALayout

@inject HttpClient Http
@inject NavigationManager Navi
@inject Services.Session Session

@inject ToastService Toast



@code
{

  private static readonly JsonSerializerOptions ApiJsonOptions = new JsonSerializerOptions(JsonSerializerDefaults.Web)
  {
    Converters = { new JsonStringEnumConverter(JsonNamingPolicy.CamelCase) }
  };

  [SupplyParameterFromQuery(Name = "category")]
  private string? CategoryFromUrl { get; set; }

  private ArticleListQueryDto _query = new()
  {
    Page = 1,
    PageSize = 25,
    ArticleNumber = null,
    Category = null,
    Branch = null,
    ModifiedSince = null,
    IncludeDeleted = false
  };

  private PagedResponseDto<ArticleResponseDto>? _articlesPage;
  private BranchResponseDto[]? _branches;
  private CategoryResponseDto[]? _categories;

  private bool _isLoading;
  private string? _articlesError;
  private string? _branchesError;
  private string? _categoriesError;

  private long? _requestDurationMs;

  protected override async Task OnInitializedAsync()
  {
    if (!Session.IsAuthenticated || string.IsNullOrWhiteSpace(Session.ApiKey))
    {
      Session.Clear();
      Navi.NavigateTo("/design-a/login");
      return;
    }

    _query.Category = int.TryParse(CategoryFromUrl, out var categoryNumber)
      ? categoryNumber
      : null;

    await Task.WhenAll(LoadArticlesAsync(), LoadBranchesAsync(), LoadCategoriesAsync());
  }

  private async Task LoadArticlesAsync()
  {
    if (_isLoading) return;

    _isLoading = true;
    _articlesError = "";
    _requestDurationMs = null;

    try
    {
      using HttpRequestMessage req = new HttpRequestMessage(HttpMethod.Post, requestUri: "api/v1/articles");

      req.Headers.Add(name: "X-API-KEY", Session?.ApiKey);
      req.Headers.Authorization = new AuthenticationHeaderValue(scheme: "Bearer", Session?.Current?.AccessToken);

      req.Content = JsonContent.Create(_query);

      Stopwatch stopwatch = Stopwatch.StartNew();

      using HttpResponseMessage res = await Http.SendAsync(req);

      if (res.StatusCode == HttpStatusCode.Unauthorized)
      {
        Session?.Clear();
        Navi.NavigateTo("/design-a/login");
        return;
      }

      if (!res.IsSuccessStatusCode)
      {
        var apiError = await res.Content.ReadFromJsonAsync<ErrorResponseDto>();
        _articlesError = apiError?.Message ?? "Die Anfrage ist fehlgeschlagen.";
        Toast.Error(_articlesError);
        return;
      }

      _articlesPage = await res.Content.ReadFromJsonAsync<PagedResponseDto<ArticleResponseDto>>(ApiJsonOptions);
      stopwatch.Stop();
      _requestDurationMs = stopwatch.ElapsedMilliseconds;
    }
    catch (HttpRequestException)
    {
      _articlesError = "Die API konnte nicht erreicht werden.";
      Toast.Error(_articlesError);
    }
    catch (OperationCanceledException)
    {
      _articlesError = "Die Anfrage wurde abgebrochen oder hat zu lange gedauert.";
      Toast.Error(_articlesError);
    }
    catch (Exception)
    {
      _articlesError = "Bei der Verarbeitung der Anfrage ist ein unerwarteter Fehler aufgetreten.";
      Toast.Error(_articlesError);
    }
    finally
    {
      _isLoading = false;
    }
  }

  private async Task LoadBranchesAsync()
  {
    _branchesError = "";
    try
    {
      using HttpRequestMessage req = new HttpRequestMessage(HttpMethod.Get, requestUri: "api/v1/branches");
      req.Headers.Add(name: "X-API-KEY", Session?.ApiKey);
      req.Headers.Authorization = new AuthenticationHeaderValue(scheme: "Bearer", Session?.Current?.AccessToken);

      using HttpResponseMessage res = await Http.SendAsync(req);

      if (res.StatusCode == HttpStatusCode.Unauthorized)
      {
        Session?.Clear();
        Navi.NavigateTo("/design-a/login");
        return;
      }

      if (!res.IsSuccessStatusCode)
      {
        ErrorResponseDto? apiError = await res.Content.ReadFromJsonAsync<ErrorResponseDto>();
        _branchesError = apiError?.Message ?? "Die Anfrage ist fehlgeschlagen.";
        Toast.Error(_branchesError);
        return;
      }

      _branches = await res.Content.ReadFromJsonAsync<BranchResponseDto[]>();
    }
    catch (HttpRequestException)
    {
      _branchesError = "Die API konnte nicht erreicht werden.";
      Toast.Error(_branchesError);
    }
    catch (OperationCanceledException)
    {
      _branchesError = "Die Anfrage wurde abgebrochen oder hat zu lange gedauert.";
      Toast.Error(_branchesError);
    }
    catch (Exception)
    {
      _branchesError = "Bei der Verarbeitung der Anfrage ist ein unerwarteter Fehler aufgetreten.";
      Toast.Error(_branchesError);
    }
  }

  private async Task LoadCategoriesAsync()
  {
    _categoriesError = "";
    try
    {
      using HttpRequestMessage req = new HttpRequestMessage(HttpMethod.Get, requestUri: "api/v1/categories");
      req.Headers.Add(name: "X-API-KEY", Session?.ApiKey);
      req.Headers.Authorization = new AuthenticationHeaderValue(scheme: "Bearer", Session?.Current?.AccessToken);

      using HttpResponseMessage res = await Http.SendAsync(req);

      if (res.StatusCode == HttpStatusCode.Unauthorized)
      {
        Session?.Clear();
        Navi.NavigateTo("/design-a/login");
        return;
      }

      if (!res.IsSuccessStatusCode)
      {
        ErrorResponseDto? apiError = await res.Content.ReadFromJsonAsync<ErrorResponseDto>();
        _categoriesError = apiError?.Message ?? "Die Anfrage ist fehlgeschlagen.";
        Toast.Error(_categoriesError);
        return;
      }

      _categories = await res.Content.ReadFromJsonAsync<CategoryResponseDto[]>();
    }
    catch (HttpRequestException)
    {
      _categoriesError = "Die API konnte nicht erreicht werden.";
      Toast.Error(_categoriesError);
    }
    catch (OperationCanceledException)
    {
      _categoriesError = "Die Anfrage wurde abgebrochen oder hat zu lange gedauert.";
      Toast.Error(_categoriesError);
    }
    catch (Exception)
    {
      _categoriesError = "Bei der Verarbeitung der Anfrage ist ein unerwarteter Fehler aufgetreten.";
      Toast.Error(_categoriesError);
    }
  }

  private Task HandleSubmit()
  {
    _query.Page = 1;
    return LoadArticlesAsync();
  }

  private void NavigateToDetail(string articleNumber)
  {
    Navi.NavigateTo($"/design-a/article-detail/{articleNumber}");
  }

  private async Task NextPageAsync()
  {
    if (_isLoading) return;
    if (_articlesPage != null && _query.Page < _articlesPage.TotalPages)
    {
      _query.Page++;
      await LoadArticlesAsync();
    }
  }

  private async Task PreviousPageAsync()
  {
    if (_isLoading) return;
    if (_query.Page > 1)
    {
      _query.Page--;
      await LoadArticlesAsync();
    }
  }

  private int FirstEntry => _articlesPage is null || _articlesPage.Data.Count == 0
    ? 0
    : (_articlesPage.Page - 1)
    * _articlesPage.PageSize + 1;

  private int LastEntry => _articlesPage is null || _articlesPage.Data.Count == 0
    ? 0
    : FirstEntry +
    _articlesPage.Data.Count - 1;

}

<PageTitle>Artikel</PageTitle>

<Toaster RichColors="@true" CloseButton="@true" />

<div class="mx-auto p-5 sm:p-8 min-w-0 lg:ml-60">

  <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#0f766e]">Datenportal · Artikel</p>
      <h1 class="mt-2 text-3xl font-semibold leading-tight tracking-tight">Das Sortiment im Überblick</h1>
      <p class="mt-3 text-sm text-slate-500">@(Session.Tenant?.Name ?? "—")</p>
    </div>
  </div>

  <EditForm Model="_query" OnValidSubmit="HandleSubmit" class="mb-6 rounded-2xl border border-[#e2e8ed] bg-white p-5">

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-5">

      <label class="block text-xs font-semibold text-slate-600">
        Artikelnummer
        <InputText @bind-Value="_query.ArticleNumber"
                   class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/20"
                   placeholder="z. B. 100234" />
      </label>

      <label class="block text-xs font-semibold text-slate-600">
        Kategorie
        <InputSelect @bind-Value="_query.Category"
                     class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/20">
          <option value="">-- Alle Kategorien --</option>
          @if (_categories != null)
            @foreach (CategoryResponseDto category in _categories)
            {
              <option value="@category.Number">@category.Name</option>
            }
        </InputSelect>
        @if (!string.IsNullOrWhiteSpace(_categoriesError))
        {
          <span role="alert" class="mt-1 block text-xs text-red-700">
            @_categoriesError
          </span>
        }
      </label>

      <label class="block text-xs font-semibold text-slate-600">
        Filiale
        <InputSelect @bind-Value="_query.Branch"
                     class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/20">
          <option value="">-- Alle Filialen --</option>
          @if (_branches != null)
            @foreach (BranchResponseDto branch in _branches)
            {
              <option value="@branch.Number">@branch.Name</option>
            }
        </InputSelect>
      </label>

      <label class="block text-xs font-semibold text-slate-600">
        Geändert seit (UTC)
        <InputDate @bind-Value="_query.ModifiedSince"
                   class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/20" />
      </label>

      <label class="block text-xs font-semibold text-slate-600">
        Einträge pro Seite
        <InputSelect @bind-Value="_query.PageSize"
                     class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#0f766e] focus:ring-2 focus:ring-[#0f766e]/20">
          <option value="5">5</option>
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
          <option value="200">200</option>
        </InputSelect>
      </label>

    </div>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-4">

      <label class="flex items-center gap-2 text-sm text-slate-600">
        <InputCheckbox @bind-Value="_query.IncludeDeleted" class="size-4 accent-[#0f766e]" /> Gelöschte einschließen
      </label>

      <div class="flex flex-wrap gap-2">
        <button disabled="@_isLoading" type="submit"
                class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e] bg-[#0f766e] text-white hover:brightness-90">
          <Icon Name="LucideIcon.Search"></Icon> Filter anwenden
        </button>
      </div>

    </div>

  </EditForm>

  <section class="min-w-0 rounded-2xl border border-[#e2e8ed] bg-white p-5 shadow-xs sm:p-6">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-base font-semibold tracking-tight">Artikelübersicht</h2>
      <span
        class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-700 ring-slate-200">
        @(_requestDurationMs.HasValue ? $"{_requestDurationMs.Value} ms" : "—")
      </span>
    </div>
    <div class="max-w-full overflow-x-auto rounded-xl border border-[#e2e8ed]">
      <table class="w-full text-left text-sm">
        <caption class="sr-only">Beispielartikel des angemeldeten Mandanten</caption>
        <thead class="bg-[#f2f6f7] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
          <tr>
            <th class="whitespace-nowrap px-4 py-3">Artikel-Nr.</th>
            <th class="whitespace-nowrap px-4 py-3">Bezeichnung / Kollektion</th>
            <th class="whitespace-nowrap px-4 py-3">Hersteller</th>
            <th class="whitespace-nowrap px-4 py-3">Kategorie</th>
            <th class="whitespace-nowrap px-4 py-3">Status</th>
            <th class="whitespace-nowrap px-4 py-3">Geändert (UTC)</th>
            <th class="whitespace-nowrap px-4 py-3">Details</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">

          @if (_isLoading)
          {
            <tr>
              <td colspan="7" role="status">
                Artikel werden geladen …
              </td>
            </tr>
          }
          else if (!string.IsNullOrWhiteSpace(_articlesError))
          {
            <tr>
              <td colspan="7" role="alert">
                @_articlesError
              </td>
            </tr>
          }
          else if (_articlesPage is null || _articlesPage.Data.Count == 0)
          {
            <tr>
              <td colspan="7" role="status">
                Keine Artikel gefunden.
              </td>
            </tr>
          }
          else
          {
            @foreach (var article in _articlesPage.Data)
            {
              <tr class="hover:bg-[#f2f6f7]">
                <td class="px-4 py-4 align-top font-medium whitespace-nowrap">
                  <span class="font-semibold text-[#0f766e] underline-offset-4 hover:underline">
                    @article.ArticleNumber
                  </span>
                </td>
                <td class="px-4 py-4 align-top tabular-nums">
                  <span class="block font-semibold text-slate-900">@article.Name</span>
                  <span class="mt-1 block text-xs text-slate-500">@article.Label</span>
                </td>
                <td class="px-4 py-4 align-top tabular-nums">@article.Manufacturer</td>
                <td class="px-4 py-4 align-top tabular-nums">
                  @foreach (ArticleCategoryDto x in article.Categories)
                  {
                    <span class="block">
                      <strong>@x.Number</strong>: @(_categories?.FirstOrDefault(y => y.Number == x.Number)?.Name ?? "-")
                    </span>
                  }
                </td>
                <td class="px-4 py-4 align-top tabular-nums">
                  <span
                    class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset @(!article.IsDeleted ? "bg-emerald-50 text-emerald-800 ring-emerald-200" : "bg-rose-50 text-rose-800 ring-rose-200")">
                    @(article.IsDeleted ? "Gelöscht" : "Aktiv")
                  </span>
                </td>
                <td class="px-4 py-4 align-top tabular-nums">@article.ModifiedAt</td>
                <td class="px-4 py-4 align-top tabular-nums">
                  <button type="button"
                          class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50"
                          @onclick="() => NavigateToDetail(article.ArticleNumber)">
                    Öffnen <Icon Name="LucideIcon.ArrowRight"></Icon>
                  </button>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-slate-500">@FirstEntry – @LastEntry von @(_articlesPage?.TotalCount ?? 0) Einträgen</p>
      <div class="flex items-center gap-2">
        <button @onclick="PreviousPageAsync"
                disabled="@(_isLoading || _articlesPage is null || _articlesPage.Page <= 1)"
                class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
          ← Zurück
        </button>

        <span class="px-2 text-sm tabular-nums">
          Seite @(_articlesPage?.Page ?? 0) / @(_articlesPage?.TotalPages ?? 0)
        </span>

        <button @onclick="NextPageAsync"
                disabled="@(_isLoading || _articlesPage is null || _articlesPage.Page >= _articlesPage.TotalPages)"
                class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0f766e] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">
          Weiter →
        </button>
      </div>
    </div>
  </section>

</div>