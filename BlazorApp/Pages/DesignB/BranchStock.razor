@page "/design-b/branch-stock"
@layout DesignBLayout

<main class="mx-auto p-5 sm:p-9 min-w-0">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#a34c27]">WebExport Studio · Filialbestände</p>
            <h1 class="mt-2 text-4xl sm:text-5xl font-semibold leading-tight tracking-tight">Bestände nach Standort</h1>
            <p class="mt-3 text-sm text-slate-500">Modehaus Muster GmbH</p>
        </div>
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-[280px_minmax(0,1fr)]">
        <form class="mb-6 rounded-2xl border border-[#e8e0d7] bg-white p-5">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
                <label class="block text-xs font-semibold text-slate-600">
                    Artikelnummer
                    <input class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20" type="text" placeholder="z. B. 100234"/>
                </label>
                <label class="block text-xs font-semibold text-slate-600">
                    SKU
                    <input class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20" type="text" placeholder="z. B. 100234-0815-042"/>
                </label>
                <label class="block text-xs font-semibold text-slate-600">
                    Filiale
                    <select class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20">
                        <option value="">Alle Filialen</option>
                        <option value="1">1 · Leer Innenstadt</option>
                        <option value="3">3 · Oldenburg</option>
                    </select>
                </label>
                <label class="block text-xs font-semibold text-slate-600">
                    Geändert seit (UTC)
                    <input class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20"type="datetime-local"/>
                </label>
                <label class="block text-xs font-semibold text-slate-600">
                    Einträge pro Seite
                    <select class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="100">100</option>
                        <option value="1000">1000</option>
                        <option value="5000">5000</option>
                    </select>
                </label>
            </div>
            <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                <div class="flex flex-col items-start gap-2">
                    <button type="button" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] bg-[#a34c27] text-white hover:brightness-90">
                        <Icon Name="LucideIcon.Search" Class="size-4"/>
                        Filter anwenden
                    </button>
                    <button type="reset" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">
                        <Icon Name="LucideIcon.ArrowLeft" Class="size-4"/>
                        Zurücksetzen
                    </button>
                </div>
            </div>
        </form>
        <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-semibold tracking-tight">Bestände je Filiale</h2>
            </div>
            <p class="mb-4 text-xs font-semibold text-[#a34c27]">Bestand: alle Filialen</p>
            <div class="max-w-full overflow-x-auto rounded-xl border border-[#e8e0d7]">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">Statische Beispieldaten für branch-stock</caption>
                    <thead class="bg-[#f8f4ee] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                    <tr>
                        <th scope="col" class="whitespace-nowrap px-4 py-3">SKU</th>
                        <th scope="col" class="whitespace-nowrap px-4 py-3">Artikel</th>
                        <th scope="col" class="whitespace-nowrap px-4 py-3">Filial-Nr.</th>
                        <th scope="col" class="whitespace-nowrap px-4 py-3">Filiale</th>
                        <th scope="col" class="whitespace-nowrap px-4 py-3">Bestand</th>
                        <th scope="col" class="whitespace-nowrap px-4 py-3">Geändert (UTC)</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                    <tr class="hover:bg-[#f8f4ee]">
                        <td class="px-4 py-4 align-top font-medium whitespace-nowrap">
                            <a class="text-[#a34c27] underline" href="/design-b/sku-detail">100234-0815-042</a>
                        </td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">
                            <a href="/design-b/article-detail" class="text-[#a34c27] underline">100234</a>
                        </td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">1</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">Leer Innenstadt</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">6,000</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">2026-10-28</td>
                    </tr>
                    <tr class="hover:bg-[#f8f4ee]">
                        <td class="px-4 py-4 align-top font-medium whitespace-nowrap">
                            <a class="text-[#a34c27] underline" href="/design-b/sku-detail">100234-0815-042</a>
                        </td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">
                            <a href="/design-b/article-detail" class="text-[#a34c27] underline">100234</a>
                        </td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">3</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">Oldenburg</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">8,000</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">2026-10-28</td>
                    </tr>
                    <tr class="hover:bg-[#f8f4ee]">
                        <td class="px-4 py-4 align-top font-medium whitespace-nowrap">100235-0815-042</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">100235</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">1</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">Leer Innenstadt</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">7,000</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">2026-10-28</td>
                    </tr>
                    <tr class="hover:bg-[#f8f4ee]">
                        <td class="px-4 py-4 align-top font-medium whitespace-nowrap">100235-0815-042</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">100235</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">3</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">Oldenburg</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">8,000</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">2026-10-28</td>
                    </tr>
                    <tr class="hover:bg-[#f8f4ee]">
                        <td class="px-4 py-4 align-top font-medium whitespace-nowrap">100236-0815-042</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">100236</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">1</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">Leer Innenstadt</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">8,000</td>
                        <td class="px-4 py-4 align-top tabular-nums whitespace-nowrap">2026-10-27</td>
                    </tr>
                    </tbody>
                </table>
            </div>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
                <p class="text-sm text-slate-500" role="status" aria-live="polite">1–5 von 10 Beispieldatensätzen</p>
                <div class="flex items-center gap-2">
                    <button type="button" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-40">← Zurück</button>
                    <span class="px-2 text-sm tabular-nums">Seite 1 / 2</span>
                    <button type="button" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">Weiter →</button>
                </div>
            </div>
        </section>
    </div>
</main>
