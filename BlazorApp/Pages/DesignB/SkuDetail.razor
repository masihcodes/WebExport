@page "/design-b/sku-detail"
@layout DesignBLayout

<main class="mx-auto p-5 sm:p-9 min-w-0">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#a34c27]">WebExport Studio · SKU-Detail</p>
            <h1 class="mt-2 text-4xl sm:text-5xl font-semibold leading-tight tracking-tight">Eine Variante. Alle Bestände.</h1>
            <p class="mt-3 text-sm text-slate-500">Modehaus Muster GmbH</p>
        </div>
    </div>

    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <a class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50" href="/design-b/article-detail">
            <Icon Name="LucideIcon.ArrowLeft" Class="size-4" aria-hidden="true" />
            Zum Artikel
        </a>
        <p class="font-mono text-sm text-slate-500">100234-0815-042</p>
    </div>
    <div class="grid gap-6 xl:grid-cols-[1.2fr_1fr]">
        <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-semibold tracking-tight">Businesshemd Slim Fit · Größe 42</h2>
            </div>
            <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                <div>
                    <dt class="text-xs font-medium text-slate-500">SKU</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">100234-0815-042</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Artikel</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                        <a class="text-[#a34c27] underline" href="/design-b/article-detail">100234 · Businesshemd Slim Fit</a>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Farbe</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                        <span class="mr-2 inline-block size-3 rounded-full bg-[#002060]"></span>
                        Dunkelblau · ID 12 · RGB 0 / 32 / 96
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Lieferantenfarbe</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">Navy</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Form</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">Slim</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Größe</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">42</dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Führende Farbe</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-emerald-50 text-emerald-800 ring-emerald-200">Ja</span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Gelöscht</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-700 ring-slate-200">Nein</span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">VK-Preis</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                        <span class="text-slate-500 line-through">79,95 €</span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Reduzierter VK-Preis</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                        <span class="text-xl font-semibold text-[#a34c27]">59,95 €</span>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium text-slate-500">Geändert (UTC)</dt>
                    <dd class="mt-1.5 wrap-break-word text-sm font-medium">28.10.2026, 14:03:11</dd>
                </div>
            </dl>
        </section>
        <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-semibold tracking-tight">Mengen nach Lieferstatus</h2>
            </div>
            <p class="text-xs text-slate-500">Gesamtbestand · alle Filialen</p>
            <p class="mb-6 mt-2 text-4xl font-semibold tracking-tight">14,000</p>
            <div class="space-y-4">
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <span class="flex items-center gap-2 text-sm">
                        <span class="size-2 rounded-full bg-emerald-500"></span>
                        Sofort lieferbar
                    </span>
                    <strong class="tabular-nums">10,000</strong>
                </div>
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <span class="flex items-center gap-2 text-sm">
                        <span class="size-2 rounded-full bg-amber-500"></span>
                        Kurzfristig lieferbar
                    </span>
                    <strong class="tabular-nums">4,000</strong>
                </div>
                <div class="flex items-center justify-between border-b border-slate-100 pb-4">
                    <span class="flex items-center gap-2 text-sm">
                        <span class="size-2 rounded-full bg-slate-400"></span>
                        Nicht lieferbar
                    </span>
                    <strong class="tabular-nums">0,000</strong>
                </div>
            </div>
        </section>
    </div>
    <div class="mt-6">
        <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
            <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-base font-semibold tracking-tight">Filialbestände</h2>
                <a class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50" href="/design-b/branch-stock?sku=100234-0815-042">Alle Filialbestände</a>
            </div>
            <div class="max-w-full overflow-x-auto rounded-xl border border-[#e8e0d7]">
                <table class="w-full text-left text-sm">
                    <caption class="sr-only">Bestände dieser SKU je Filiale</caption>
                    <thead class="bg-[#f8f4ee] text-[11px] font-semibold uppercase tracking-wider text-slate-500">
                        <tr>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Filiale</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Name</th>
                            <th scope="col" class="whitespace-nowrap px-4 py-3">Bestand</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        <tr class="hover:bg-[#f8f4ee]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">1</td>
                            <td class="px-4 py-4 align-top tabular-nums">Leer Innenstadt</td>
                            <td class="px-4 py-4 align-top tabular-nums">6,000</td>
                        </tr>
                        <tr class="hover:bg-[#f8f4ee]">
                            <td class="px-4 py-4 align-top font-medium whitespace-nowrap">3</td>
                            <td class="px-4 py-4 align-top tabular-nums">Oldenburg</td>
                            <td class="px-4 py-4 align-top tabular-nums">8,000</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="mt-4 text-sm text-slate-500">6,000 + 8,000 = 14,000 Gesamtbestand</p>
        </section>
    </div>
</main>
