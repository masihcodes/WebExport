@page "/design-b/prices-stock"
@layout DesignBLayout

<main class="mx-auto p-5 sm:p-9 min-w-0">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#a34c27]">WebExport Studio · Preise &amp; Bestände</p>
            <h1 class="mt-2 text-4xl sm:text-5xl font-semibold leading-tight tracking-tight">Der schnelle Datenabgleich</h1>
            <p class="mt-3 text-sm text-slate-500">Modehaus Muster GmbH</p>
        </div>
    </div>

    <div class="grid items-start gap-6 xl:grid-cols-[280px_minmax(0,1fr)]">
        <form class="mb-6 rounded-2xl border border-[#e8e0d7] bg-white p-5">
            <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-1">
                <label class="block text-xs font-semibold text-slate-600" for="articleNumber">
                    Artikelnummer
                    <input class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20" id="articleNumber" name="articleNumber" type="text" placeholder="z. B. 100234" />
                </label>
                <label class="block text-xs font-semibold text-slate-600" for="branch">
                    Filiale
                    <select class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20" id="branch" name="branch">
                        <option value="">Alle Filialen</option>
                        <option value="1">1 · Leer Innenstadt</option>
                        <option value="3">3 · Oldenburg</option>
                    </select>
                </label>
                <label class="block text-xs font-semibold text-slate-600" for="modifiedSince">
                    Geändert seit (UTC)
                    <input class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20" id="modifiedSince" name="modifiedSince" type="datetime-local" />
                </label>
                <label class="block text-xs font-semibold text-slate-600" for="pageSize">
                    Einträge pro Seite
                    <select class="mt-2 min-h-11 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm text-slate-900 outline-none focus:border-[#a34c27] focus:ring-2 focus:ring-[#a34c27]/20" id="pageSize" name="pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="100">100</option>
                        <option value="1000">1000</option>
                        <option value="5000">5000</option>
                    </select>
                </label>
            </div>
            <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
                <label class="flex items-center gap-2 text-sm text-slate-600">
                    <input class="size-4 accent-[#a34c27]" type="checkbox" name="includeDeleted" />
                    Gelöschte einschließen
                </label>
                <div class="flex flex-col items-start gap-2">
                    <button type="button" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] bg-[#a34c27] text-white hover:brightness-90">
                        <Icon Name="LucideIcon.Search" Class="size-4" aria-hidden="true" />
                        Filter anwenden
                    </button>
                    <button type="reset" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-semibold transition focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#a34c27] border border-slate-300 bg-white text-slate-700 hover:bg-slate-50">
                        <Icon Name="LucideIcon.ArrowLeft" Class="size-4" aria-hidden="true" />
                        Zurücksetzen
                    </button>
                </div>
            </div>
        </form>
        <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
