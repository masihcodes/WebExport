@page "/design-b/status"
@layout DesignBLayout

<main class="mx-auto max-w-360 p-5 sm:p-9">

    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-[#a34c27]">WebExport Studio · Status</p>
            <h1 class="mt-2 text-4xl sm:text-5xl font-semibold leading-tight tracking-tight">Ihre Daten · Auf einen Blick</h1>
        </div>
    </div>

    <div>
        <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            <div class="rounded-2xl border border-[#e8e0d7] bg-white p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500">API-Status</p>
                    <span class="size-2 rounded-full bg-emerald-500 animate-ping"></span>
                </div>
                <p class="mt-5 text-2xl font-semibold tracking-tight">Erreichbar</p>
                <p class="mt-2 text-xs text-slate-500">Version 1.0.0</p>
            </div>
            <div class="rounded-2xl border border-[#e8e0d7] bg-white p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500">Datenbank</p>
                    <span class="size-2 rounded-full bg-emerald-500 animate-ping"></span>
                </div>
                <p class="mt-5 text-2xl font-semibold tracking-tight">Verbunden</p>
                <p class="mt-2 text-xs text-slate-500">PostgreSQL · Testdaten</p>
            </div>
            <div class="rounded-2xl border border-[#e8e0d7] bg-white p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500">Mandant</p>
                    <span class="size-2 rounded-full bg-emerald-500 animate-ping"></span>
                </div>
                <p class="mt-5 text-2xl font-semibold tracking-tight">Nr. 1</p>
                <p class="mt-2 text-xs text-slate-500">Modehaus Muster GmbH</p>
            </div>
            <div class="rounded-2xl border border-[#e8e0d7] bg-white p-6">
                <div class="flex items-center justify-between">
                    <p class="text-xs font-semibold text-slate-500">Filialen</p>
                    <span class="size-2 rounded-full bg-emerald-500 animate-ping"></span>
                </div>
                <p class="mt-5 text-2xl font-semibold tracking-tight">2</p>
                <p class="mt-2 text-xs text-slate-500">Leer &amp; Oldenburg</p>
            </div>
        </div>
        <div class="grid gap-6 xl:grid-cols-[1.3fr_1fr]">
            <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
                <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                    <h2 class="text-base font-semibold tracking-tight">Ihr Datenzugang</h2>
                </div>
                <dl class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2">
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Angemeldeter Mandant</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">Modehaus Muster GmbH</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Mandantennummer</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">1</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Client-ID (aus der Demo-Anmeldung)</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">webshop-test</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Sitzung</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">60 Minuten · Beispiel</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Status geprüft am</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">29.10.2026, 09:15 UTC</dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium text-slate-500">Umgebung</dt>
                        <dd class="mt-1.5 wrap-break-word text-sm font-medium">
                            <span
                                class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset bg-slate-100 text-slate-700 ring-slate-200">
                                Lokale
                                Testumgebung
                            </span>
                        </dd>
                    </div>
                </dl>
                <p class="mt-6 rounded-xl bg-[#f8f4ee] p-4 text-sm leading-relaxed text-slate-600">
                    Der Mandant wird durch den
                    angemeldeten Client bestimmt. Die Filialauswahl schränkt die Bestandsanzeige ein.
                </p>
            </section>
            <section class="min-w-0 rounded-2xl border border-[#e8e0d7] bg-white p-5 shadow-xs sm:p-6">
                <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
                    <h2 class="text-base font-semibold tracking-tight">Direkt zu Ihren Daten</h2>
                </div>
                <div class="space-y-3">
                    <a class="flex items-center justify-between rounded-xl border border-[#e8e0d7] p-4 transition hover:bg-[#f8f4ee]"
                       href="articles.html">
                        <span>
                            <span class="block font-semibold">Artikel ansehen</span>
                            <span
                                class="mt-1 block text-xs text-slate-500">
                                Sortiment, Varianten und Details
                            </span>
                        </span>
                        <svg
                            class="size-5 shrink-0 fill-none stroke-current stroke-[1.6] [stroke-linecap:round] [stroke-linejoin:round]"
                            aria-hidden="true" viewBox="0 0 24 24">
                            <path d="M5 12h14m-6-6 6 6-6 6"></path>
                        </svg>
                    </a>
                    <a
                        class="flex items-center justify-between rounded-xl border border-[#e8e0d7] p-4 transition hover:bg-[#f8f4ee]"
                        href="prices-stock.html">
                        <span>
                            <span class="block font-semibold">Preise &amp; Bestände</span>
                            <span
                                class="mt-1 block text-xs text-slate-500">
                                Kompakte Übersicht je SKU
                            </span>
                        </span>
                        <svg
                            class="size-5 shrink-0 fill-none stroke-current stroke-[1.6] [stroke-linecap:round] [stroke-linejoin:round]"
                            aria-hidden="true" viewBox="0 0 24 24">
                            <path d="M5 12h14m-6-6 6 6-6 6"></path>
                        </svg>
                    </a>
                    <a
                        class="flex items-center justify-between rounded-xl border border-[#e8e0d7] p-4 transition hover:bg-[#f8f4ee]"
                        href="categories.html">
                        <span>
                            <span class="block font-semibold">Kategorien erkunden</span>
                            <span
                                class="mt-1 block text-xs text-slate-500">
                                Von der Struktur zum Artikel
                            </span>
                        </span>
                        <svg
                            class="size-5 shrink-0 fill-none stroke-current stroke-[1.6] [stroke-linecap:round] [stroke-linejoin:round]"
                            aria-hidden="true" viewBox="0 0 24 24">
                            <path d="M5 12h14m-6-6 6 6-6 6"></path>
                        </svg>
                    </a>
                </div>
            </section>
        </div>
    </div>

</main>

