@inherits LayoutComponentBase

@inject Services.Session Session
@inject NavigationManager Navi
@implements IDisposable

@code{
    private void ChangeAsync() => _ = InvokeAsync(StateHasChanged);
    protected override void OnInitialized() => Session.Changed += ChangeAsync;
    public void Dispose() => Session.Changed -= ChangeAsync;

    private void HandleLogout()
    {
        Session.Clear();
        Navi.NavigateTo(uri: "/design-b/login");
    }

}

<header class="bg-[#302e35] text-white">
    <div class="mx-auto flex max-w-360 flex-wrap items-center justify-between gap-4 px-5 py-6 sm:px-9">
        <span class="flex items-center gap-3 animate-pulse">
            <Icon Name="LucideIcon.Package"></Icon>
            <span class="text-lg font-semibold tracking-tight">
                WebExport <span class="font-normal opacity-50">Api</span>
            </span>
        </span>
        <div class="text-right">
            <p class="mt-1 text-sm">
                Modehaus Muster GmbH
                <button @onclick="HandleLogout" class="ml-4 text-xs text-white/50 underline">Abmelden</button>
            </p>
        </div>
    </div>
    <nav class="mx-auto flex max-w-360 gap-1 overflow-x-auto px-5 pb-4 sm:px-9">
        <NavLink
            href="/design-b/status"
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-white/65 hover:bg-white/5 hover:text-white"
            ActiveClass="bg-[#a34c27] text-white">
            <Icon Name="LucideIcon.Activity"></Icon> Status
        </NavLink>
        <NavLink
            href="/design-b/articles"
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-white/65 hover:bg-white/5 hover:text-white"
            ActiveClass="bg-[#a34c27] text-white">
            <Icon Name="LucideIcon.Package"></Icon> Artikel
        </NavLink>
        <NavLink
            href="/design-b/prices-stock"
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-white/65 hover:bg-white/5 hover:text-white"
            ActiveClass="bg-[#a34c27] text-white">
            <Icon Name="LucideIcon.Layers"></Icon> Preise &amp; Bestände
        </NavLink>
        <NavLink
            href="/design-b/branch-stock"
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-white/65 hover:bg-white/5 hover:text-white"
            ActiveClass="bg-[#a34c27] text-white">
            <Icon Name="LucideIcon.Store"></Icon> Filialbestände
        </NavLink>
        <NavLink
            href="/design-b/categories"
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-white/65 hover:bg-white/5 hover:text-white"
            ActiveClass="bg-[#a34c27] text-white">
            <Icon Name="LucideIcon.Layers"></Icon> Kategorien
        </NavLink>
        <NavLink
            href="/design-b/master-data"
            class="flex items-center gap-3 rounded-lg px-3 py-3 text-sm font-medium text-white/65 hover:bg-white/5 hover:text-white"
            ActiveClass="bg-[#a34c27] text-white">
            <Icon Name="LucideIcon.Grip"></Icon> Stammdaten
        </NavLink>
    </nav>
</header>


@Body


<footer class="mt-8 flex w-full flex-wrap justify-between gap-3 border-t border-slate-200 pt-5 text-xs text-slate-500">
    <span class="font-semibold mx-8 mb-5">HILTES Software GmbH · WebExportApi</span>
    <span class="font-semibold mx-8 mb-5">Postgres · ASP.NET Core · Blazor · HTML · Tailwind CSS · 10.2026</span>
</footer>
