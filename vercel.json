{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix WebExport.Portal ci --include=dev",
  "buildCommand": "bash WebExport.Portal/build-vercel.sh",
  "outputDirectory": "publish/wwwroot",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}